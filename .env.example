# Copier ce fichier en .env puis adapter. Ne jamais committer le .env.

# --- Portail ---------------------------------------------------------------
# URL de base du portail (avec le / final).
PMMP_BASE_URL=https://www.marchespublics.gov.ma/
# Chemin (relatif à PMMP_BASE_URL) de la page listant les consultations en cours.
# Si le portail renvoie le formulaire de recherche, le collecteur le soumet avec ses valeurs par défaut.
PMMP_SEARCH_PATH=index.php?page=entreprise.EntrepriseAdvancedSearch&AllCons

# --- Base de données ---------------------------------------------------------
PMMP_DATABASE_URL=postgresql://pmmp_app:CHANGE_ME@localhost:5432/pmmp_veille

# --- Identification (obligatoire, jamais l'UA par défaut de Scrapy) ---------
PMMP_USER_AGENT=TACHFIR-VeilleMarchesPublics/1.0 (+contact: sales@tachfir.com)

# --- Règles de collecte (chef de projet) -------------------------------------
# Pause entre deux requêtes, en secondes. Minimum imposé par le code : 1.0
PMMP_DOWNLOAD_DELAY=3
# Fenêtre horaire autorisée (HH:MM-HH:MM), fuseau ci-dessous. Peut passer minuit.
# 06:00-10:00 = matin, choix du stagiaire (25/09/2026), DIFFÉRENT de la consigne d'origine
# du chef de projet (nuit / heures creuses). Pour revenir à la nuit : 23:00-06:00
PMMP_ALLOWED_WINDOW=06:00-10:00
PMMP_TIMEZONE=Africa/Casablanca
# Circuit breaker : nombre d'échecs/lenteurs consécutifs avant arrêt du run.
PMMP_CB_MAX_CONSECUTIVE=3
# Au-delà de ce temps de réponse (s), une réponse est comptée comme "lente".
PMMP_CB_SLOW_SECONDS=15
# Timeout réseau par requête (s). Un timeout compte comme un échec.
PMMP_DOWNLOAD_TIMEOUT=30

# --- Mode ----------------------------------------------------------------------
# prod | test   (en test : copie des pages dans fixtures/live/)
PMMP_MODE=prod
# Collecte par lots (voir README §6) : une nuit visite au plus PMMP_MAX_ITEMS fiches
# détail (+ leurs DCE). Avec PMMP_INCREMENTAL=true, seules les consultations nouvelles,
# modifiées ou en échec comptent : le lot suivant reprend la nuit d'après.
PMMP_INCREMENTAL=true
PMMP_MAX_ITEMS=2000
# Résultats par page de liste (10, 20, 50, 100 ou 500, comme sur le portail)
PMMP_PAGE_SIZE=100
# Limite optionnelle de pages de liste (0 = pas de limite)
PMMP_MAX_PAGES=0
# Plafonds appliqués à un run lancé avec --force hors fenêtre horaire
PMMP_FORCE_MAX_PAGES=1
PMMP_FORCE_MAX_ITEMS=10

# --- Stockage ------------------------------------------------------------------
PMMP_DOWNLOAD_DCE=true
PMMP_STORAGE_DIR=storage
PMMP_FIXTURES_DIR=fixtures
PMMP_LOG_LEVEL=INFO
